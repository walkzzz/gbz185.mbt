---
import {
  "moonbitlang/async",
  "moonbitlang/async/fs" @fs,
  "moonbitlang/async/process" @proc,
}
---

// GB/Z 185 协议栈变异测试（gbz185 仓版；运行：moon run scripts/mutation_test.mbtx）
// 对每个变异：生成变异源文件 → moon test → 判定 KILLED/SURVIVED → 恢复 → 汇总报告

///|
struct Mutation {
  id : String
  file : String
  old_sub : String
  new_sub : String
  desc : String
}

///|
let mutations : Array[Mutation] = [
  {
    id: "M01",
    file: "aip/protocol.mbt",
    old_sub: "self.outbox_seq = @verify.next_seq(self.outbox_seq)",
    new_sub: "self.outbox_seq = @verify.next_seq(@verify.next_seq(self.outbox_seq))",
    desc: "AIP outbox step doubled",
  },
  {
    id: "M02",
    file: "aip/protocol.mbt",
    old_sub: "guard @verify.inbox_advance(last, env.seq) else {",
    new_sub: "guard @verify.inbox_advance(last, env.seq - 1L) else {",
    desc: "AIP replay seq comparison loosened",
  },
  {
    id: "M03",
    file: "aip/protocol.mbt",
    old_sub: "recipient_urn.has_prefix(@wire.group_urn_prefix())",
    new_sub: "recipient_urn.has_prefix(\"urn:agent:grp:\")",
    desc: "group URN prefix mutated",
  },
  {
    id: "M04",
    file: "aip/protocol.mbt",
    old_sub: "guard resp.accepted else {",
    new_sub: "guard !resp.accepted else {",
    desc: "ATR client acceptance negated",
  },
  {
    id: "M05",
    file: "aip/protocol.mbt",
    old_sub: "guard env.recipient_urn == self.self_node.urn else {",
    new_sub: "guard env.recipient_urn != self.self_node.urn else {",
    desc: "AIP recipient check negated",
  },
  {
    id: "M06",
    file: "aip/protocol.mbt",
    old_sub: "guard env.sender_urn != self.self_node.urn else {",
    new_sub: "guard env.sender_urn == self.self_node.urn else {",
    desc: "AIP self-loop check negated",
  },
  {
    id: "M07",
    file: "identity/identity.mbt",
    old_sub: "NoIdentity => \"none\"",
    new_sub: "NoIdentity => \"noneX\"",
    desc: "identity wire value mutated",
  },
  {
    id: "M08",
    file: "identity/identity.mbt",
    old_sub: "in_seg && segments >= 2",
    new_sub: "in_seg && segments >= 1",
    desc: "AIC single-segment validation loosened",
  },
  {
    id: "M09",
    file: "aip/codec.mbt",
    old_sub: "guard ver == envelope_version() else {",
    new_sub: "guard ver != envelope_version() else {",
    desc: "envelope version check negated",
  },
  {
    id: "M10",
    file: "registry/registry.mbt",
    old_sub: "let verdict = verifier.verify(cai_ref)",
    new_sub: "let verdict = true",
    desc: "ATR authentication short-circuited",
  },
  {
    id: "M11",
    file: "discovery/discovery.mbt",
    old_sub: "if require_discoverable && !self.discoverable {",
    new_sub: "if false && !self.discoverable {",
    desc: "ADP discoverable filter disabled (AgentNode::matches)",
  },
  {
    id: "M12",
    file: "tooling/tooling.mbt",
    old_sub: "Some(String(\"native\")) => NativeBinding",
    new_sub: "Some(String(\"native\")) => McpBinding(\"mutated\")",
    desc: "tool binding constructor swapped",
  },
  {
    id: "M13",
    file: "capability/capability.mbt",
    old_sub: "if !has_capability(self.capabilities, req) {",
    new_sub: "if false {",
    desc: "ACS covers/missing short-circuited (coverage always true, missing empty)",
  },
  {
    id: "M14",
    file: "identity/identity.mbt",
    old_sub: "self is Active",
    new_sub: "self is NoIdentity",
    desc: "IdentityStatus::is_active verdict inverted",
  },
  {
    id: "M15",
    file: "aip/envelope.mbt",
    old_sub: "}#",
    new_sub: "}:#",
    desc: "envelope message id separator mutated",
  },
  {
    id: "M16",
    file: "aip/protocol.mbt",
    old_sub: "Some(s) => s",
    new_sub: "Some(_s) => 0L",
    desc: "inbox watermark read and replay baseline forced to zero",
  },
  {
    id: "M17",
    file: "registry/registry.mbt",
    old_sub: "e.node.acs.capabilities.length() >= need &&",
    new_sub: "e.node.acs.capabilities.length() > need &&",
    desc: "capability length pruning drops equal-size candidates",
  },
  {
    id: "M18",
    file: "tooling/tooling.mbt",
    old_sub: "self.tools.get(name) is Some(_)",
    new_sub: "self.tools.get(name) is None",
    desc: "ToolRegistry::is_registered negated",
  },
  {
    id: "M19",
    file: "aip/route.mbt",
    old_sub: "Some(members) => members.contains(member_urn)",
    new_sub: "Some(_members) => false",
    desc: "RouteTable::is_member always false",
  },
]

///|
fn replace_all(s : String, old : String, new : String) -> String {
  let parts = s.split(old)
  if parts.length() == 1 {
    return s
  }
  let buf = StringBuilder()
  for i, p in parts {
    buf.write_string(p.to_string())
    if i < parts.length() - 1 {
      buf.write_string(new)
    }
  }
  buf.to_string()
}

///|
async fn run_tests() -> Int {
  let (code, _out, _err) = @proc.collect_output("moon", ["test"], cwd=".") catch {
    _ => panic()
  }
  code
}

///|
async fn main raise {
  let files = [
    "aip/protocol.mbt",
    "aip/codec.mbt",
    "aip/envelope.mbt",
    "aip/route.mbt",
    "capability/capability.mbt",
    "identity/identity.mbt",
    "registry/registry.mbt",
    "discovery/discovery.mbt",
    "tooling/tooling.mbt",
  ]
  let sources : Map[String, String] = Map([])
  for f in files {
    let content = @fs.read_file(f).text() catch { _ => panic() }
    sources[f] = content
  }
  let mut killed = 0
  let mut survived = 0
  let results : Array[String] = []
  for m in mutations {
    let original = sources.get(m.file).unwrap_or("")
    let mutated = replace_all(original, m.old_sub, m.new_sub)
    if mutated == original {
      results.push("\{m.id}: NOT-APPLIED (pattern not found: \{m.old_sub})")
      continue
    }
    @fs.write_file(m.file, mutated)
    let code = run_tests()
    if code == 0 {
      survived += 1
      results.push("\{m.id}: SURVIVED — \{m.desc}")
    } else {
      killed += 1
      results.push("\{m.id}: KILLED — \{m.desc}")
    }
    @fs.write_file(m.file, original)
  }
  let final_code = run_tests()
  for r in results {
    println(r)
  }
  println("=== mutation summary ===")
  println("killed=\{killed} survived=\{survived} total=\{mutations.length()}")
  if final_code == 0 {
    println("baseline restored: tests green")
  } else {
    println("WARNING: baseline tests failing after restore — manual check needed")
  }
}
